# Límite de tamaño (bytes) para las imágenes que procesan los analizadores.
UPLOAD_MAX_BYTES=5242880

# --- Dataset Copilot (Frente 8 / T-3.3) ---
# Capa gratuita de Google AI Studio (aistudio.google.com/apikey). Sin esta
# variable, el Copilot funciona igual en las pruebas automatizadas (usan un
# doble de LLM) pero la prueba en vivo de tests/copilot/test_live_gemini_smoke.py
# se salta. Nunca versionar este archivo con la clave real -- copiar a .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
COPILOT_DATA_DIR=contracts/examples
