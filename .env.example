# Copiar a .env y ajustar valores reales. Nunca versionar .env.

# --- App ---
NODE_ENV=development
# Local/on-premise: 3000. Config de producción: 3100.
PORT=3000
# Límite de tamaño para la carga de imágenes (POST /api/images)
MAX_UPLOAD_MB=10

# Artefactos reales del pipeline de Python (DVC): de aquí lee el dashboard
# la telemetría de los analizadores (T-202). Se materializa con `dvc pull`
# o `dvc repro`; si la carpeta está vacía, el dashboard lo dice en pantalla.
PIPELINE_ARTIFACTS_DIR=data/processed
# Política de la compuerta que edita la pantalla Settings, e imágenes crudas
# del dataset (DVC) para las miniaturas. Rutas relativas a la raíz del repo.
QUALITY_POLICY_PATH=quality.yaml
RAW_IMAGES_DIR=data/raw/images

# --- MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=annotation_portal
DB_USER=annotation_user
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root
DATABASE_URL=mysql://annotation_user:changeme@localhost:3306/annotation_portal

# --- MinIO ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=annotation-images
# Consola web de MinIO (opcional, solo para inspección manual)
MINIO_CONSOLE_PORT=9001
